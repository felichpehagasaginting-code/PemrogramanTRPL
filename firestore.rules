rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com') &&
        (request.auth.token.email == "felich@mhs.cwe.ac.id" || 
         request.auth.token.email == "felichpehagasa@gmail.com");
    }

    // Users Collection with Anti-Tampering Protection (Public Read for Class Leaderboard)
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) || isAdmin();
      // Owner can update profile with non-tampered roles and bounded XP increments
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.uid == userId &&
        (!('isCreator' in request.resource.data) || request.resource.data.isCreator == resource.data.isCreator) &&
        (!('isDosenPenguji' in request.resource.data) || request.resource.data.isDosenPenguji == resource.data.isDosenPenguji) &&
        request.resource.data.xp >= resource.data.xp &&
        (request.resource.data.xp - resource.data.xp <= 350)
      );
      allow delete: if isAdmin();
    }

    // Help & Discussion Snapshots (Fitur Minta Bantuan & Help Desk)
    match /help_snapshots/{snapshotId} {
      allow read: if true; // Public read-only for mentor/peers
      allow create: if isAuthenticated();
      // Only author can edit ticket content; peers/mentors can only update status/mentorNote
      allow update: if isAdmin() || (
        isAuthenticated() && (
          (resource.data.authorId == request.auth.uid && request.resource.data.authorId == resource.data.authorId) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'mentorNote', 'updatedAt'])
        )
      );
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid);
    }

    // Real-time Pair Programming Rooms, Collaborative Chat, & Peer Presence
    match /pair_rooms/{roomId} {
      allow read, write: if isAuthenticated();
      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
          request.resource.data.text is string &&
          request.resource.data.text.size() <= 1000;
        allow delete: if isAdmin();
      }
      match /peers/{peerId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Global App Configuration & Announcements
    match /app_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Verified Certificates Registry
    match /certificates/{certId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && (
        request.resource.data.studentUid == request.auth.uid || isAdmin()
      );
      allow delete: if isAdmin();
    }
  }
}
