rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == "felich@mhs.cwe.ac.id" || 
         request.auth.token.email == "felichpehagasa@gmail.com");
    }

    // Users Collection with Anti-Tampering Protection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) || isAdmin();
      // Owner can update profile info with bounded XP increments (max +350 XP per valid module step)
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.uid == userId &&
        request.resource.data.xp >= resource.data.xp &&
        (request.resource.data.xp - resource.data.xp <= 350)
      );
      allow delete: if isAdmin();
    }

    // Help & Discussion Snapshots (Fitur Minta Bantuan & Help Desk)
    match /help_snapshots/{snapshotId} {
      allow read: if true; // Public read-only for mentor/peers
      allow create: if isAuthenticated();
      allow update: if isAdmin() || (isAuthenticated() && (resource.data.authorId == request.auth.uid || request.resource.data.status != null));
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid);
    }
  }
}
